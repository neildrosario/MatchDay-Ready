rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserProfile() {
      return isSignedIn() && exists(userDocPath(request.auth.uid));
    }

    function getUserData() {
      return hasUserProfile() ? get(userDocPath(request.auth.uid)).data : null;
    }

    function isActiveUser() {
      return hasUserProfile() && (
        !('status' in getUserData()) || getUserData().status == 'active'
      );
    }

    function userClubId() {
      return isActiveUser() ? getUserData().clubId : null;
    }

    function userRole() {
      return isActiveUser() ? getUserData().role : null;
    }

    function isClubMember(clubId) {
      return isActiveUser() && clubId != null && userClubId() == clubId;
    }

    function isClubAdmin(clubId) {
      return isClubMember(clubId) && (userRole() == 'admin' || isPrimaryOwnerAdmin());
    }

    function isClubLeadForAgeGroup(clubId, ageGroup) {
      return isClubMember(clubId)
        && userRole() == 'lead'
        && ageGroup != null
        && 'assignedAgeGroups' in getUserData()
        && getUserData().assignedAgeGroups is list
        && ageGroup in getUserData().assignedAgeGroups;
    }

    function isAssignedTeamId(teamId) {
      return isActiveUser()
        && teamId != null
        && 'assignedTeamIds' in getUserData()
        && getUserData().assignedTeamIds is list
        && teamId in getUserData().assignedTeamIds;
    }

    function canEditTeam(clubId, teamId) {
      return isClubMember(clubId) && userRole() != 'viewer' && (
        userRole() == 'admin' ||
        isAssignedTeamId(teamId) ||
        (
          userRole() == 'lead'
          && teamId != null
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && get(/databases/$(database)/documents/teams/$(teamId)).data.clubId == clubId
          && isClubLeadForAgeGroup(clubId, get(/databases/$(database)/documents/teams/$(teamId)).data.ageGroup)
        )
      );
    }

    function authEmailLower() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    // Verified platform/club owner admin (strictly Google/verified email match for Neil)
    function isPrimaryOwnerAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && authEmailLower() == 'neildrosario@gmail.com';
    }

    function isValidRole(role) {
      return role in ['admin', 'lead', 'coach', 'viewer'];
    }

    function boolFlagDefaultTrue(obj, key) {
      return !(key in obj) || obj[key] == true;
    }

    function safeList(obj, key) {
      return (key in obj && obj[key] is list) ? obj[key] : [];
    }

    function safeJoinCodeRole(codeDoc) {
      return ('defaultRole' in codeDoc && codeDoc.defaultRole in ['coach', 'viewer'])
        ? codeDoc.defaultRole
        : 'coach';
    }

    // Pre-authorized email invite claim (first-time profile creation)
    function isValidInviteClaimDoc(newUser, inv) {
      return inv.status == 'pending'
        && authEmailLower() != ''
        && 'email' in inv
        && inv.email is string
        && inv.email.lower() == authEmailLower()
        && newUser.clubId == inv.clubId
        && newUser.role == inv.role
        && newUser.status == 'active'
        && newUser.assignedTeamIds == safeList(inv, 'assignedTeamIds')
        && newUser.assignedAgeGroups == safeList(inv, 'assignedAgeGroups')
        && boolFlagDefaultTrue(newUser, 'canViewSplitter') == (inv.role == 'admin' || boolFlagDefaultTrue(inv, 'canViewSplitter'))
        && boolFlagDefaultTrue(newUser, 'canViewStats') == (inv.role == 'admin' || boolFlagDefaultTrue(inv, 'canViewStats'));
    }

    function isValidInviteClaim(newUser) {
      return 'claimedInviteId' in newUser
        && newUser.claimedInviteId is string
        && exists(/databases/$(database)/documents/invites/$(newUser.claimedInviteId))
        && isValidInviteClaimDoc(newUser, get(/databases/$(database)/documents/invites/$(newUser.claimedInviteId)).data);
    }

    // Self-registration via active Club Registration Code (instant coach profile, 0 assigned teams until Lead/Admin approves team request)
    function isValidJoinCodeRegistrationDoc(newUser, codeDoc) {
      let allowedRole = safeJoinCodeRole(codeDoc);
      return codeDoc.active == true
        && newUser.clubId == codeDoc.clubId
        && newUser.role == allowedRole
        && newUser.status == 'active'
        && newUser.assignedTeamIds is list
        && newUser.assignedTeamIds.size() == 0
        && newUser.assignedAgeGroups is list
        && newUser.assignedAgeGroups.size() == 0
        && boolFlagDefaultTrue(newUser, 'canViewSplitter') == true
        && boolFlagDefaultTrue(newUser, 'canViewStats') == true
        && newUser.memberClubIds is list
        && newUser.memberClubIds == [codeDoc.clubId]
        && 'clubMemberships' in newUser
        && newUser.clubMemberships.keys().hasOnly([codeDoc.clubId])
        && newUser.clubMemberships[codeDoc.clubId].clubId == codeDoc.clubId
        && newUser.clubMemberships[codeDoc.clubId].role == allowedRole
        && newUser.clubMemberships[codeDoc.clubId].status == 'active'
        && newUser.clubMemberships[codeDoc.clubId].assignedTeamIds is list
        && newUser.clubMemberships[codeDoc.clubId].assignedTeamIds.size() == 0
        && newUser.clubMemberships[codeDoc.clubId].assignedAgeGroups is list
        && newUser.clubMemberships[codeDoc.clubId].assignedAgeGroups.size() == 0;
    }

    function isValidJoinCodeRegistration(newUser) {
      return 'joinedViaCode' in newUser
        && newUser.joinedViaCode is string
        && exists(/databases/$(database)/documents/joinCodes/$(newUser.joinedViaCode))
        && isValidJoinCodeRegistrationDoc(newUser, get(/databases/$(database)/documents/joinCodes/$(newUser.joinedViaCode)).data);
    }

    // Multi-club: existing user joining an additional club via active Club Registration Code
    function isValidAdditionalJoinCodeRegistrationDoc(userId, codeDoc) {
      let nextClub = codeDoc.clubId;
      let allowedRole = safeJoinCodeRole(codeDoc);
      return request.auth.uid == userId
        && codeDoc.active == true
        && request.resource.data.clubId == nextClub
        && request.resource.data.role == allowedRole
        && request.resource.data.status == 'active'
        && request.resource.data.assignedTeamIds is list
        && request.resource.data.assignedTeamIds.size() == 0
        && request.resource.data.assignedAgeGroups is list
        && request.resource.data.assignedAgeGroups.size() == 0
        && 'clubMemberships' in request.resource.data
        && nextClub in request.resource.data.clubMemberships
        && request.resource.data.clubMemberships[nextClub].clubId == nextClub
        && request.resource.data.clubMemberships[nextClub].role == allowedRole
        && request.resource.data.clubMemberships[nextClub].status == 'active'
        && request.resource.data.clubMemberships[nextClub].assignedTeamIds is list
        && request.resource.data.clubMemberships[nextClub].assignedTeamIds.size() == 0
        && (
          (
            'clubMemberships' in resource.data
            && request.resource.data.clubMemberships.diff(resource.data.clubMemberships).affectedKeys().hasOnly([nextClub])
          ) || (
            !('clubMemberships' in resource.data)
            && request.resource.data.clubMemberships.keys().hasOnly([resource.data.clubId, nextClub])
            && request.resource.data.clubMemberships[resource.data.clubId].clubId == resource.data.clubId
            && request.resource.data.clubMemberships[resource.data.clubId].role == resource.data.role
            && request.resource.data.clubMemberships[resource.data.clubId].assignedTeamIds == safeList(resource.data, 'assignedTeamIds')
          )
        );
    }

    function isValidAdditionalJoinCodeRegistration(userId) {
      return 'joinedViaCode' in request.resource.data
        && request.resource.data.joinedViaCode is string
        && exists(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinedViaCode))
        && isValidAdditionalJoinCodeRegistrationDoc(userId, get(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinedViaCode)).data);
    }

    // Multi-club: switching active club using an already-authorized membership entry
    function isValidClubSwitch(userId) {
      let nextClub = request.resource.data.clubId;
      return request.auth.uid == userId
        && 'clubMemberships' in resource.data
        && nextClub in resource.data.clubMemberships
        && isValidClubSwitchTarget(resource.data.clubMemberships[nextClub]);
    }

    function isValidClubSwitchTarget(target) {
      return request.resource.data.clubMemberships == resource.data.clubMemberships
        && request.resource.data.role == target.role
        && request.resource.data.status == target.status
        && request.resource.data.assignedTeamIds == safeList(target, 'assignedTeamIds')
        && request.resource.data.assignedAgeGroups == safeList(target, 'assignedAgeGroups')
        && boolFlagDefaultTrue(request.resource.data, 'canViewSplitter') == boolFlagDefaultTrue(target, 'canViewSplitter')
        && boolFlagDefaultTrue(request.resource.data, 'canViewStats') == boolFlagDefaultTrue(target, 'canViewStats')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['clubId', 'role', 'status', 'assignedTeamIds', 'assignedAgeGroups', 'canViewSplitter', 'canViewStats', 'updatedAt']);
    }

    // Multi-club: existing user registering a brand-new club that does not exist yet
    function isValidNewClubAddition(userId) {
      let nextClub = request.resource.data.clubId;
      return request.auth.uid == userId
        && nextClub is string
        && nextClub != resource.data.clubId
        && !exists(/databases/$(database)/documents/clubs/$(nextClub))
        && request.resource.data.role == 'admin'
        && request.resource.data.status == 'active'
        && 'clubMemberships' in request.resource.data
        && nextClub in request.resource.data.clubMemberships
        && request.resource.data.clubMemberships[nextClub].clubId == nextClub
        && request.resource.data.clubMemberships[nextClub].role == 'admin'
        && request.resource.data.clubMemberships[nextClub].status == 'active'
        && (
          (
            'clubMemberships' in resource.data
            && request.resource.data.clubMemberships.diff(resource.data.clubMemberships).affectedKeys().hasOnly([nextClub])
          ) || (
            !('clubMemberships' in resource.data)
            && request.resource.data.clubMemberships.keys().hasOnly([resource.data.clubId, nextClub])
            && request.resource.data.clubMemberships[resource.data.clubId].clubId == resource.data.clubId
            && request.resource.data.clubMemberships[resource.data.clubId].role == resource.data.role
            && request.resource.data.clubMemberships[resource.data.clubId].assignedTeamIds == safeList(resource.data, 'assignedTeamIds')
          )
        );
    }

    // Multi-club: existing user claiming a pending invite to an additional club
    function isValidAdditionalInviteClaimDoc(userId, inv) {
      let nextClub = inv.clubId;
      return request.auth.uid == userId
        && inv.status == 'pending'
        && authEmailLower() != ''
        && 'email' in inv
        && inv.email is string
        && inv.email.lower() == authEmailLower()
        && request.resource.data.clubId == nextClub
        && request.resource.data.role == inv.role
        && request.resource.data.status == 'active'
        && request.resource.data.assignedTeamIds == safeList(inv, 'assignedTeamIds')
        && request.resource.data.assignedAgeGroups == safeList(inv, 'assignedAgeGroups')
        && boolFlagDefaultTrue(request.resource.data, 'canViewSplitter') == (inv.role == 'admin' || boolFlagDefaultTrue(inv, 'canViewSplitter'))
        && boolFlagDefaultTrue(request.resource.data, 'canViewStats') == (inv.role == 'admin' || boolFlagDefaultTrue(inv, 'canViewStats'))
        && 'clubMemberships' in request.resource.data
        && nextClub in request.resource.data.clubMemberships
        && request.resource.data.clubMemberships[nextClub].clubId == nextClub
        && request.resource.data.clubMemberships[nextClub].role == inv.role
        && request.resource.data.clubMemberships[nextClub].status == 'active'
        && request.resource.data.clubMemberships[nextClub].assignedTeamIds == safeList(inv, 'assignedTeamIds')
        && request.resource.data.clubMemberships[nextClub].assignedAgeGroups == safeList(inv, 'assignedAgeGroups')
        && boolFlagDefaultTrue(request.resource.data.clubMemberships[nextClub], 'canViewSplitter') == (inv.role == 'admin' || boolFlagDefaultTrue(inv, 'canViewSplitter'))
        && boolFlagDefaultTrue(request.resource.data.clubMemberships[nextClub], 'canViewStats') == (inv.role == 'admin' || boolFlagDefaultTrue(inv, 'canViewStats'))
        && (
          (
            'clubMemberships' in resource.data
            && request.resource.data.clubMemberships.diff(resource.data.clubMemberships).affectedKeys().hasOnly([nextClub])
          ) || (
            !('clubMemberships' in resource.data)
            && request.resource.data.clubMemberships.keys().hasOnly([resource.data.clubId, nextClub])
            && request.resource.data.clubMemberships[resource.data.clubId].clubId == resource.data.clubId
            && request.resource.data.clubMemberships[resource.data.clubId].role == resource.data.role
            && request.resource.data.clubMemberships[resource.data.clubId].assignedTeamIds == safeList(resource.data, 'assignedTeamIds')
          )
        );
    }

    function isValidAdditionalInviteClaim(userId) {
      return 'claimedInviteId' in request.resource.data
        && request.resource.data.claimedInviteId is string
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.claimedInviteId))
        && isValidAdditionalInviteClaimDoc(userId, get(/databases/$(database)/documents/invites/$(request.resource.data.claimedInviteId)).data);
    }

    // Multi-club: Admin of clubA updating a multi-club member's clubA membership (or approving joinRequest)
    function isAdminUpdatingClubMembership(userId) {
      let targetClub = userClubId();
      let hasPendingReq = exists(/databases/$(database)/documents/joinRequests/$(targetClub + '__' + userId))
        && get(/databases/$(database)/documents/joinRequests/$(targetClub + '__' + userId)).data.status == 'pending';
      let isExistingClubMember = 'memberClubIds' in resource.data
        && resource.data.memberClubIds is list
        && targetClub in resource.data.memberClubIds;
      return isClubAdmin(targetClub)
        && (hasPendingReq || isExistingClubMember)
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.role == resource.data.role
        && 'clubMemberships' in request.resource.data
        && targetClub in request.resource.data.clubMemberships
        && (
          (
            'clubMemberships' in resource.data
            && request.resource.data.clubMemberships.diff(resource.data.clubMemberships).affectedKeys().hasOnly([targetClub])
          ) || (
            !('clubMemberships' in resource.data)
            && request.resource.data.clubMemberships.keys().hasOnly([resource.data.clubId, targetClub])
            && request.resource.data.clubMemberships[resource.data.clubId].clubId == resource.data.clubId
            && request.resource.data.clubMemberships[resource.data.clubId].role == resource.data.role
          )
        );
    }

    // Age-Group Lead approving a pending team access request for a team in their assigned age group
    function isLeadApprovingTeamRequestDoc(userId, reqDoc) {
      let clubId = reqDoc.clubId;
      let prevTeams = safeList(resource.data, 'assignedTeamIds');
      let nextTeams = safeList(request.resource.data, 'assignedTeamIds');
      let isActiveInClub = resource.data.clubId == clubId;
      return reqDoc.status == 'pending'
        && reqDoc.uid == userId
        && isClubLeadForAgeGroup(clubId, reqDoc.ageGroup)
        && resource.data.role != 'admin'
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && safeList(request.resource.data, 'assignedAgeGroups') == safeList(resource.data, 'assignedAgeGroups')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['assignedTeamIds', 'clubMemberships', 'memberClubIds', 'approvedTeamRequestId', 'updatedAt'])
        && (
          !isActiveInClub || (
            reqDoc.teamId in nextTeams
            && nextTeams.hasAll(prevTeams)
            && nextTeams.size() <= prevTeams.size() + 1
          )
        )
        && 'clubMemberships' in request.resource.data
        && clubId in request.resource.data.clubMemberships
        && reqDoc.teamId in safeList(request.resource.data.clubMemberships[clubId], 'assignedTeamIds')
        && (
          (
            'clubMemberships' in resource.data
            && request.resource.data.clubMemberships.diff(resource.data.clubMemberships).affectedKeys().hasOnly([clubId])
          ) || (
            !('clubMemberships' in resource.data)
            && request.resource.data.clubMemberships.keys().hasOnly([resource.data.clubId])
          )
        );
    }

    function isLeadApprovingTeamRequest(userId) {
      return 'approvedTeamRequestId' in request.resource.data
        && request.resource.data.approvedTeamRequestId is string
        && exists(/databases/$(database)/documents/teamRequests/$(request.resource.data.approvedTeamRequestId))
        && isLeadApprovingTeamRequestDoc(userId, get(/databases/$(database)/documents/teamRequests/$(request.resource.data.approvedTeamRequestId)).data);
    }

    // --- USERS (COACHES, AGE-GROUP LEADS, VIEWERS & CLUB ADMINS) ---
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isClubMember(resource.data.clubId) ||
        ('memberClubIds' in resource.data && resource.data.memberClubIds is list && userClubId() in resource.data.memberClubIds)
      );

      allow create: if isSignedIn()
        && request.resource.data.uid == userId
        && isValidRole(request.resource.data.role)
        && (
          // 1. Club Admin creating a member
          isClubAdmin(request.resource.data.clubId)
          // 2. Pre-authorized invited user claiming their exact invite (zero registration code needed)
          || (request.auth.uid == userId && isValidInviteClaim(request.resource.data))
          // 3. New coach self-registering with a valid active Club Registration Code (starts with 0 teams)
          || (request.auth.uid == userId && isValidJoinCodeRegistration(request.resource.data))
          // 4. Verified primary owner admin (neildrosario@gmail.com) always defaults to Club Admin
          || (
            request.auth.uid == userId
            && isPrimaryOwnerAdmin()
            && request.resource.data.role == 'admin'
            && request.resource.data.status == 'active'
          )
          // 5. Founding Admin bootstrapping a brand-new club that does not exist yet
          || (
            request.auth.uid == userId
            && request.resource.data.role == 'admin'
            && request.resource.data.status == 'active'
            && request.resource.data.clubId is string
            && !exists(/databases/$(database)/documents/clubs/$(request.resource.data.clubId))
          )
        );

      allow update: if isSignedIn() && (
        // 0. Verified primary owner admin self-syncing default Admin role
        (
          request.auth.uid == userId
          && isPrimaryOwnerAdmin()
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'active'
        )
        // 1. Club Admin updating a member currently active in their club
        || (
          isClubAdmin(resource.data.clubId)
          && request.resource.data.clubId == resource.data.clubId
          && isValidRole(request.resource.data.role)
        )
        // 2. Club Admin updating/approving a multi-club member's entry for their club
        || isAdminUpdatingClubMembership(userId)
        // 3. Age-Group Lead approving a coach's pending team access request in their age group
        || isLeadApprovingTeamRequest(userId)
        // 4. Multi-club user switching between their already-authorized clubs
        || isValidClubSwitch(userId)
        // 5. Existing user registering a brand-new isolated club
        || isValidNewClubAddition(userId)
        // 6. Existing user claiming an invite to an additional club
        || isValidAdditionalInviteClaim(userId)
        // 7. Existing user joining an additional club via active Club Registration Code
        || isValidAdditionalJoinCodeRegistration(userId)
        // 8. Non-admin self-updates restricted strictly to safe profile fields
        || (
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'lastSeenAt'])
        )
      );

      allow delete: if isClubAdmin(resource.data.clubId) && request.auth.uid != userId;
    }

    // --- EMAIL INVITES (PRE-AUTHORIZED COACHES) ---
    match /invites/{inviteId} {
      allow get: if isSignedIn() && (
        (authEmailLower() != '' && resource.data.email is string && resource.data.email.lower() == authEmailLower()) ||
        isClubAdmin(resource.data.clubId)
      );

      allow list: if isSignedIn() && (
        (authEmailLower() != '' && resource.data.email == authEmailLower()) ||
        isClubAdmin(resource.data.clubId)
      );

      allow create: if isClubAdmin(request.resource.data.clubId)
        && request.resource.data.status == 'pending'
        && isValidRole(request.resource.data.role);

      allow update: if (
        isClubAdmin(resource.data.clubId)
        && request.resource.data.clubId == resource.data.clubId
      ) || (
        isSignedIn()
        && authEmailLower() != ''
        && resource.data.email is string
        && resource.data.email.lower() == authEmailLower()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'claimedAt'])
      );

      allow delete: if isClubAdmin(resource.data.clubId);
    }

    // --- CLUB JOIN CODES (EXACT LOOKUP ONLY; NO GLOBAL LISTING) ---
    match /joinCodes/{code} {
      allow get: if isSignedIn();
      allow list: if isClubAdmin(resource.data.clubId);
      allow create: if isClubAdmin(request.resource.data.clubId);
      allow update, delete: if isClubAdmin(resource.data.clubId);
    }

    // --- TEAM ACCESS REQUESTS (COACH REQUESTS SPECIFIC TEAM; ADMIN OR AGE-GROUP LEAD APPROVES) ---
    match /teamRequests/{requestId} {
      allow read: if isClubMember(resource.data.clubId) && (
        resource.data.uid == request.auth.uid ||
        userRole() == 'admin' ||
        userRole() == 'lead'
      );

      allow create: if isClubMember(request.resource.data.clubId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.teamId is string
        && exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId))
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.clubId == request.resource.data.clubId
        && request.resource.data.ageGroup == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.ageGroup;

      allow update: if (
        isClubAdmin(resource.data.clubId) ||
        isClubLeadForAgeGroup(resource.data.clubId, resource.data.ageGroup)
      ) && request.resource.data.clubId == resource.data.clubId;

      allow delete: if isClubAdmin(resource.data.clubId)
        || isClubLeadForAgeGroup(resource.data.clubId, resource.data.ageGroup)
        || (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // --- LEGACY CLUB JOIN REQUESTS (BACKWARD COMPATIBLE APPROVAL QUEUE) ---
    match /joinRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isClubAdmin(resource.data.clubId)
      );

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.joinCode is string
        && exists(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode))
        && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode)).data.active == true
        && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode)).data.clubId == request.resource.data.clubId;

      allow update: if isClubAdmin(resource.data.clubId)
        && request.resource.data.clubId == resource.data.clubId;

      allow delete: if isClubAdmin(resource.data.clubId)
        || (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // --- CLUBS ---
    match /clubs/{clubId} {
      allow get: if isSignedIn() && (
        isClubMember(clubId) ||
        !exists(/databases/$(database)/documents/clubs/$(clubId))
      );
      allow list: if isClubMember(clubId);
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/clubs/$(clubId));
      allow update: if isClubAdmin(clubId);
      allow delete: if false;
    }

    // --- TEAMS ---
    match /teams/{teamId} {
      allow read: if isClubMember(resource.data.clubId);
      allow create: if isClubAdmin(request.resource.data.clubId)
        || isClubLeadForAgeGroup(request.resource.data.clubId, request.resource.data.ageGroup);
      allow update: if (
        isClubAdmin(resource.data.clubId) ||
        isClubLeadForAgeGroup(resource.data.clubId, resource.data.ageGroup)
      ) && request.resource.data.clubId == resource.data.clubId;
      allow delete: if isClubAdmin(resource.data.clubId);
    }

    // --- PLAYERS ---
    match /players/{playerId} {
      allow read: if isClubMember(resource.data.clubId);
      allow create: if isClubMember(request.resource.data.clubId) && userRole() != 'viewer';
      allow update: if isClubMember(resource.data.clubId)
        && request.resource.data.clubId == resource.data.clubId
        && userRole() != 'viewer';
      allow delete: if isClubMember(resource.data.clubId) && (
        isClubAdmin(resource.data.clubId) ||
        isClubLeadForAgeGroup(resource.data.clubId, resource.data.ageGroup) ||
        (userRole() == 'coach' && isAssignedTeamId(resource.data.primaryTeamId))
      );
    }

    // --- MATCHES ---
    match /matches/{matchId} {
      allow read: if isActiveUser() && (
        resource.data.clubId == userClubId() ||
        isAssignedTeamId(resource.data.teamId)
      );
      allow create: if canEditTeam(request.resource.data.clubId, request.resource.data.teamId);
      allow update: if canEditTeam(request.resource.data.clubId, request.resource.data.teamId)
        && (!('clubId' in resource.data) || resource.data.clubId == request.resource.data.clubId);
      allow delete: if isClubAdmin(resource.data.clubId);
    }

    // --- LINEUPS ---
    match /lineups/{lineupId} {
      allow read: if isActiveUser() && (
        resource.data.clubId == userClubId() ||
        isAssignedTeamId(resource.data.teamId)
      );
      allow create: if canEditTeam(request.resource.data.clubId, request.resource.data.teamId);
      allow update: if canEditTeam(request.resource.data.clubId, request.resource.data.teamId)
        && (!('clubId' in resource.data) || resource.data.clubId == request.resource.data.clubId);
      allow delete: if isClubAdmin(resource.data.clubId);
    }
  }
}
